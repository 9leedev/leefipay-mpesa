{
    "name": "leefipay/mpesa",
    "description": "Official Laravel package for integrating applications with the LeefiPay M-Pesa Open API.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "leefipay",
        "mpesa",
        "stk-push",
        "payments",
        "kenya",
        "api"
    ],
    "authors": [
        {
            "name": "LeefiPay",
            "email": "support@leefipay.com",
            "homepage": "https://leefipay.com"
        }
    ],
    "homepage": "https://github.com/9leedev/leefipay-mpesa",
    "support": {
        "issues": "https://github.com/9leedev/leefipay-mpesa/issues",
        "source": "https://github.com/9leedev/leefipay-mpesa"
    },
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.5",
        "illuminate/contracts": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/events": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^9.6|^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "LeefiPay\\Mpesa\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LeefiPay\\Mpesa\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LeefiPay\\Mpesa\\LeefiPayServiceProvider"
            ],
            "aliases": {
                "LeefiPay": "LeefiPay\\Mpesa\\Facades\\LeefiPay"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
